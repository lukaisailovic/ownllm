{
  "name": "llmgate",
  "version": "0.1.0",
  "description": "Self-hostable, subscription-auth, OpenAI-compatible API gateway with real per-request model routing.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.6.5",
  "bin": {
    "llmgate": "./dist/main.js"
  },
  "files": ["dist", "config.example.yaml", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsup",
    "dev": "tsx watch src/main.ts",
    "cli": "tsx src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "citty": "^0.1.6",
    "eventsource-parser": "^3.0.0",
    "hono": "^4.6.0",
    "open": "^10.1.0",
    "pino": "^9.5.0",
    "tough-cookie": "^5.0.0",
    "yaml": "^2.6.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@types/node": "^22.10.0",
    "openai": "^4.77.0",
    "pino-pretty": "^13.0.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
